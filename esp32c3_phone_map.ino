static const TFont TFONTS[3] = {{tf0_g,187,tf0_b,-13,4,3},{tf1_g,187,tf1_b,-16,4,3},{tf2_g,187,tf2_b,-21,6,4}};


static uint8_t fontIdx = 1;

static uint16_t nextCp(const char *&s) {          // ถอดรหัส UTF-8 ทีละตัว
  uint8_t c = (uint8_t)*s;
  if (!c) return 0;
  if (c < 0x80) { s++; return c; }
  if ((c & 0xE0) == 0xC0 && s[1]) { uint16_t r = ((c & 0x1F) << 6) | (s[1] & 0x3F); s += 2; return r; }
  if ((c & 0xF0) == 0xE0 && s[1] && s[2]) { uint16_t r = ((c & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F); s += 3; return r; }
  s++;
  while ((*s & 0xC0) == 0x80) s++;                // ข้ามตัวอักษรนอกช่วง (เช่น emoji)
  return ' ';
}

static const TG *findGlyph(const TFont &f, uint16_t cp) {
  int lo = 0, hi = f.n - 1;
  while (lo <= hi) {
    int mid = (lo + hi) >> 1;
    uint16_t c = f.g[mid].cp;
    if (c == cp) return &f.g[mid];
    if (c < cp) lo = mid + 1; else hi = mid - 1;
  }
  return nullptr;
}

static bool isUpper(uint16_t cp) {   // สระบน/ไม้หันอากาศ/นิคหิต -> วรรณยุกต์อยู่สูง
  return cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E37) || cp == 0x0E47 || cp == 0x0E4D || cp == 0x0E33;
}
static bool isTone(uint16_t cp) { return cp >= 0x0E48 && cp <= 0x0E4C; }

// วาดข้อความไทย คืนค่าตำแหน่ง x สุดท้าย (draw=false ใช้วัดความกว้าง)
static int thaiText(int x, int base, const char *s, uint8_t fi, bool draw = true) {
  const TFont &f = TFONTS[fi];
  bool prevUpper = false;
  while (*s) {
    uint16_t cp = nextCp(s);
    if (cp == '\n' || cp == '\r') cp = ' ';
    const TG *g = findGlyph(f, cp);
    if (!g) { x += f.bot - f.top > 20 ? 6 : 4; prevUpper = false; continue; }
    int dy = (isTone(cp) && !prevUpper) ? f.toneDrop : 0;
    if (draw && g->w) u8g2.drawXBMP(x + g->x, base + g->y + dy, g->w, g->h, f.b + g->off);
    if (g->adv) prevUpper = false;
    if (isUpper(cp)) prevUpper = true;
    x += g->adv;
  }
  return x;
}
static int thaiWidth(const char *s, uint8_t fi) { return thaiText(0, 0, s, fi, false); }
static int lineH(uint8_t fi) { return TFONTS[fi].bot - TFONTS[fi].top; }

// กล่องข้อความ: ถ้ายาวเกินจะเลื่อนแบบตัววิ่ง
static uint32_t strHash(const char *s) { uint32_t h = 5381; while (*s) h = h * 33 + (uint8_t)*s++; return h; }

static void textBox(int x0, int y0, int w, int h, const char *s, uint8_t fi, Scroller &sc, bool center = false) {
  const TFont &f = TFONTS[fi];
  int base = y0 + (h - lineH(fi)) / 2 - f.top;
  int tw = thaiWidth(s, fi);
  u8g2.setClipWindow(x0, y0, x0 + w - 1, y0 + h - 1);
  if (tw <= w) {
    thaiText(center ? x0 + (w - tw) / 2 : x0, base, s, fi);
  } else {
    uint32_t hs = strHash(s);
    if (hs != sc.hash) { sc.hash = hs; sc.start = millis(); }
    int period = tw + 30;
    int t = (int)((millis() - sc.start) / 30) - 40;   // หยุดรอแป๊บก่อนเลื่อน
    int off = t > 0 ? t % period : 0;
    thaiText(x0 - off, base, s, fi);
    thaiText(x0 - off + period, base, s, fi);
  }
  u8g2.setMaxClipWindow();
}

