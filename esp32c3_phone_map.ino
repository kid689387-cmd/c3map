static bool has(const String &s, const char *k) { return s.indexOf(k) >= 0; }
static Turn guessTurn(const String &t) {
  if (has(t, "กลับรถ") || has(t, "U-turn") || has(t, "u-turn")) return T_UTURN;
  if (has(t, "วงเวียน") || has(t, "oundabout")) return T_ROUND;
  if (has(t, "จุดหมาย") || has(t, "estination")) return T_ARRIVE;
  if (has(t, "ชิดขวา") || has(t, "เบี่ยงขวา") || has(t, "eep right") || has(t, "light right")) return T_SRIGHT;
  if (has(t, "ชิดซ้าย") || has(t, "เบี่ยงซ้าย") || has(t, "eep left") || has(t, "light left")) return T_SLEFT;
  if (has(t, "ขวา") || has(t, "right") || has(t, "Right")) return T_RIGHT;
  if (has(t, "ซ้าย") || has(t, "left") || has(t, "Left")) return T_LEFT;
  return T_STRAIGHT;
}
static void thick(int x0, int y0, int x1, int y1) {
  for (int dx = -2; dx <= 2; dx++) for (int dy = -2; dy <= 2; dy++)
    if (dx * dx + dy * dy <= 5) u8g2.drawLine(x0 + dx, y0 + dy, x1 + dx, y1 + dy);
}
static void head(int x, int y, float ang) {      // หัวลูกศร ปลายที่ (x,y) ชี้ทิศ ang (เรเดียน, 0 = ขึ้น)
  float s = sinf(ang), c = -cosf(ang);
  int bx = x - s * 11, by = y - c * 11;
  u8g2.drawTriangle(x, y, bx - c * 9, by + s * 9, bx + c * 9, by - s * 9);
}
static void drawTurn(Turn t, int cx, int cy) {    // กล่อง ~44x44 รอบ (cx,cy)
  const float D = 0.0174533f;
  int bx = cx, by = cy + 20, mx = cx, my = cy + 2;
  switch (t) {
    case T_UTURN:
      thick(cx + 8, cy + 20, cx + 8, cy - 4);
      for (int a = 0; a <= 180; a += 10) u8g2.drawDisc(cx + cosf(a * D) * 8, cy - 4 - sinf(a * D) * 8, 2);
      thick(cx - 8, cy - 4, cx - 8, cy + 8);
      head(cx - 8, cy + 18, 180 * D);
      break;
    case T_ARRIVE:
      u8g2.drawDisc(cx, cy - 6, 12); u8g2.setDrawColor(0); u8g2.drawDisc(cx, cy - 6, 5); u8g2.setDrawColor(1);
      u8g2.drawTriangle(cx - 10, cy + 1, cx + 10, cy + 1, cx, cy + 20);
      break;
    default: {
      int ang = t == T_RIGHT ? 90 : t == T_LEFT ? -90 : t == T_SRIGHT ? 45 : t == T_SLEFT ? -45 : 0;
      if (ang == 90 || ang == -90) my = cy - 5;     // เลี้ยว: ยกจุดหักขึ้นให้อยู่กลางกล่อง
      if (t == T_ROUND) { u8g2.drawCircle(mx, my, 8); u8g2.drawCircle(mx, my, 7); ang = 45; }
      float a = ang * D;
      int ex = mx + sinf(a) * 14, ey = my - cosf(a) * 14;
      thick(bx, by, mx, my); thick(mx, my, ex, ey);
      head(mx + sinf(a) * 22, my - cosf(a) * 22, a);
    }
  }
}

// ---- หาระยะทาง เช่น "350 ม." / "1.2 กม." / "500 m" ในข้อความ ----
static bool dg(char c) { return c >= '0' && c <= '9'; }
static bool al(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
static String findDistance(const String &t) {
  int n = t.length();
  for (int i = 0; i < n; i++) {
    if (!dg(t[i]) || (i > 0 && (dg(t[i - 1]) || t[i - 1] == ':' || t[i - 1] == '.'))) continue;
    int j = i;
    while (j < n && (dg(t[j]) || t[j] == '.' || t[j] == ',')) j++;
    int k = j;
    while (k < n && t[k] == ' ') k++;
    String rest = t.substring(k, k + 9);
    int ulen = 0;
    if (rest.startsWith("กม.")) ulen = strlen("กม.");
    else if (rest.startsWith("กม")) ulen = strlen("กม");
    else if (rest.startsWith("ม.")) ulen = strlen("ม.");
    else if (rest.startsWith("เมตร")) ulen = strlen("เมตร");
    else if (rest.startsWith("km")) ulen = 2;
    else if (rest.startsWith("m") && (k + 1 >= n || !al(t[k + 1]))) ulen = 1;
    if (ulen) return t.substring(i, k + ulen);
  }
  return "";
}

static int toMeters(String d) {                    // "350 ม." -> 350, "1.2 กม." -> 1200
  if (!d.length()) return -1;
  d.replace(",", "");
  float v = d.toFloat();
  bool km = d.indexOf("กม") >= 0 || d.indexOf("km") >= 0;
  return (int)(km ? v * 1000 : v);
}
static int navDistM() {
  Navigation &nav = watch.getNavigation();
  String d = findDistance(nav.title);
  if (!d.length()) d = findDistance(nav.directions);
  return toMeters(d);
}

static bool iconBlank() {                          // ไอคอนแทบไม่มีจุด = ใช้ไม่ได้
  int c = 0;
  for (int i = 0; i < 288; i++) c += __builtin_popcount(iconXbm[i]);
  return c < 60;
}

static void screenNav() {
  Navigation &nav = watch.getNavigation();
  refreshIcon(nav);
  String title = nav.title, dir = nav.directions;
  String all = title + " " + dir + " " + nav.distance;
  String info = nav.duration;
  if (nav.distance.length()) { if (info.length()) info += " "; info += nav.distance; }
  if (nav.eta.length()) { if (info.length()) info += " "; info += nav.eta; }

  const uint8_t fi = fontIdx;
  int bh = lineH(fi) + 2;                 // แถบล่าง: คำสั่ง/ชื่อถนน
  int top = 64 - bh;

  // ซ้าย: ไอคอนจาก Google หรือลูกศรที่วาดเอง
  u8g2.setClipWindow(0, 0, 47, top - 1);
  if (iconOk && !iconBlank()) u8g2.drawXBMP(0, top >= 48 ? (top - 48) / 2 : (top - 48) / 2, 48, 48, iconXbm);
  else drawTurn(guessTurn(all), 23, top / 2 - 2);
  u8g2.setMaxClipWindow();

  // ขวา: บรรทัดใหญ่ = ระยะถึงจุดเลี้ยว (ถ้าหาเจอ) ไม่งั้นใช้หัวข้อ, บรรทัดเล็ก = ข้อมูลที่เหลือ
  String dist = findDistance(title);
  if (!dist.length()) dist = findDistance(dir);
  String big = dist.length() ? dist : title;
  String small = dist.length() ? title : info;
  if (dist.length() && title == dist) small = info;
  if (small == big) small = "";
  const int rx = 50, rw = 78;
  int lh = lineH(fi), sh = lineH(0);
  int bigY = 0, bigH = top;

  // บรรทัดชื่อจุดหมาย (ส่งมาจากหน้าเว็บ) อยู่บนสุด
  String dest;
  portENTER_CRITICAL(&mux); dest = String(destBuf); portEXIT_CRITICAL(&mux);
  String destLine = dest.length() ? String("ไป ") + dest : String("");
  if (destLine.length() && sh + lh > top) {        // ตัวอักษรใหญ่: ที่ไม่พอ สลับแสดงกับบรรทัดใหญ่ทุก 3 วินาที
    if ((millis() / 3000) % 2) big = destLine;
    destLine = "";
  }
  if (destLine.length() && small.length() && top < sh + lh + sh) {   // ที่ไม่พอ 3 บรรทัด: รวมเวลาถึงไว้กับชื่อจุดหมาย
    destLine += "  ";
    destLine += small;
    small = "";
  }
  int rowsH = (destLine.length() ? sh : 0) + lh + (small.length() && top >= lh + sh + (destLine.length() ? sh : 0) ? sh : 0);
  bool showSmall = small.length() && top >= rowsH && rowsH > lh + (destLine.length() ? sh : 0);
  int y = (top - rowsH) / 2;
  if (y < 0) y = 0;
  if (destLine.length()) {
    textBox(rx, y, rw, sh, destLine.c_str(), 0, scDest, true);
    y += sh;
  }
  if (destLine.length() || showSmall) {
    bigY = y; bigH = lh;
    textBox(rx, y, rw, lh, big.c_str(), fi, scTitle, true);
    y += lh;
    if (showSmall) textBox(rx, y, rw, sh, small.c_str(), 0, scInfo, true);
  } else {
    textBox(rx, 0, rw, top, big.c_str(), fi, scTitle, true);
  }

  // เตือนใกล้ถึงจุดเลี้ยว: <=100 ม. ระยะกระพริบ, <=30 ม. กรอบจอกระพริบเร็วขึ้น
  int m = toMeters(dist);
  if (m >= 0 && m <= 100) {
    bool ph = (millis() / (m <= 30 ? 150 : 300)) % 2;
    if (ph) {
      u8g2.setDrawColor(2); u8g2.drawBox(rx - 1, bigY, rw + 1, bigH); u8g2.setDrawColor(1);
      if (m <= 30) { u8g2.drawFrame(0, 0, 128, 64); u8g2.drawFrame(1, 1, 126, 62); }
    }
  }

  u8g2.setDrawColor(0); u8g2.drawBox(0, top, 128, bh); u8g2.setDrawColor(1);
  u8g2.drawHLine(0, top, 128);
  textBox(0, top + 1, 128, bh - 1, dir.length() ? dir.c_str() : "กำลังนำทาง…", fi, scDir, false);
}

// ======================= แจ้งเตือน / สายเข้า =======================
static NItem hist[5];
static int histN = 0, histView = 0;               // hist[0] = ล่าสุด
static Notification pendingN;
static volatile bool notifPending = false;
static String callerName;
static volatile bool ringing = false;
static bool callHidden = false;
static uint32_t popupUntil = 0;

void onNotification(Notification n) { pendingN = n; notifPending = true; }
void onRinger(String caller, bool state) { callerName = caller; ringing = state; }

static void takeNotification(bool navOn) {
  if (!notifPending) return;
  notifPending = false;
  for (int i = 4; i > 0; i--) hist[i] = hist[i - 1];
  hist[0].app = pendingN.app; hist[0].title = pendingN.title; hist[0].msg = pendingN.message;
  if (histN < 5) histN++;
  histView = 0;
  popupUntil = millis() + (navOn ? 4000 : 7000);
}

static Scroller scA, scB, scC;
static void headerBar(const String &txt, bool inv = true) {
  if (inv) { u8g2.drawBox(0, 0, 128, 17); u8g2.setDrawColor(0); }
  textBox(1, 0, 126, 17, txt.c_str(), 0, scA, true);
  u8g2.setDrawColor(1);
}
static void screenNotif(const NItem &n, const String &head) {
  headerBar(head);
  uint8_t tf = fontIdx, mf = fontIdx == 0 ? 0 : 1;
  int th = lineH(tf), mh = 64 - 18 - th;
  textBox(0, 18, 128, th, n.title.length() ? n.title.c_str() : n.app.c_str(), tf, scB, true);
  textBox(0, 18 + th, 128, mh, n.msg.c_str(), mf, scC, false);
}
static void screenCall() {
  bool ph = (millis() / 400) % 2;
  headerBar("สายเรียกเข้า", ph);
  if (!ph) u8g2.drawHLine(0, 17, 128);
  textBox(0, 20, 128, 44, callerName.length() ? callerName.c_str() : "ไม่ทราบเบอร์", fontIdx, scB, true);
}

// ======================= นาฬิกา =======================
static const char *TH_DAY[] = { "อา.", "จ.", "อ.", "พ.", "พฤ.", "ศ.", "ส." };
static const char *TH_MON[] = { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
static void screenClock(const char *hint) {
  u8g2.setFont(u8g2_font_logisoso28_tn);
  String t = watch.getTime("%H:%M");
  int w = u8g2.getStrWidth(t.c_str());
  u8g2.drawStr((128 - w) / 2, 31, t.c_str());
  String d = String(TH_DAY[watch.getDayofWeek() % 7]) + " " + String(watch.getDay()) + " " + TH_MON[watch.getMonth() % 12];
  if (hint && (millis() / 4000) % 2) d = hint;
  textBox(0, 40, 128, 24, d.c_str(), 0, scIdle, true);
}

static void screenIdle(bool chronos) {
  if (chronos) {
    screenClock("เปิดนำทางใน Google Maps");
  } else {
    textBox(0, 0, 128, 20, "แผนที่ C3-Map", 1, scIdle, true);
    u8g2.drawHLine(0, 21, 128);
    static Scroller a, b;
    textBox(0, 23, 128, 20, "เว็บ: กด \"เชื่อม ESP32\"", 0, a, true);
    textBox(0, 43, 128, 20, "หรือเชื่อมแอป Chronos", 0, b, true);
  }
}

// ======================= ปุ่มกด =======================
static Mode dispMode = M_AUTO;
static String toastTxt;
static uint32_t toastUntil = 0;
static void toast(const String &t) { toastTxt = t; toastUntil = millis() + 1200; }
static const char *MODE_NAME[] = { "อัตโนมัติ", "นาฬิกา", "แจ้งเตือน" };
static const char *SIZE_NAME[] = { "ตัวอักษรเล็ก", "ตัวอักษรกลาง", "ตัวอักษรใหญ่" };

static void shortPress() {
  if (ringing && !callHidden) { callHidden = true; return; }
  if (millis() < popupUntil) { popupUntil = 0; return; }
  dispMode = (Mode)((dispMode + 1) % 3);
  histView = 0;
  toast(MODE_NAME[dispMode]);
}
static void longPress() {
  if (dispMode == M_NOTIF && histN > 1) { histView = (histView + 1) % histN; return; }
  fontIdx = (fontIdx + 1) % 3;
  fontChanged = true;
  toast(SIZE_NAME[fontIdx]);
}
static void handleButton() {
  static bool lastRaw = HIGH, stable = HIGH, longDone = false;
  static uint32_t lastEdge = 0, downAt = 0;
  bool raw = digitalRead(PIN_BTN);
  if (raw != lastRaw) { lastRaw = raw; lastEdge = millis(); }
  if (millis() - lastEdge > 25 && raw != stable) {
    stable = raw;
    if (stable == LOW) { downAt = millis(); longDone = false; }
    else if (!longDone) shortPress();
  }
  if (stable == LOW && !longDone && millis() - downAt > 800) { longDone = true; longPress(); }
}
static void drawToast() {
  if (millis() >= toastUntil) return;
  int w = thaiWidth(toastTxt.c_str(), 0) + 10;
  if (w > 126) w = 126;
  int x = (128 - w) / 2;
  u8g2.setDrawColor(0); u8g2.drawBox(x - 1, 22, w + 2, 21); u8g2.setDrawColor(1);
  u8g2.drawRBox(x, 23, w, 19, 3);
  u8g2.setDrawColor(0);
  static Scroller st;
  textBox(x + 2, 24, w - 4, 17, toastTxt.c_str(), 0, st, true);
  u8g2.setDrawColor(1);
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BTN, INPUT_PULLUP);
  prefs.begin("c3map", false);
  fontIdx = prefs.getUChar("fs", 1);
  if (fontIdx > 2) fontIdx = 1;
  prefs.getString("dest", destBuf, sizeof(destBuf));

  u8g2.setBusClock(400000);
  u8g2.begin();
  u8g2.setBitmapMode(1);   // วาดเฉพาะจุดที่ติด (โปร่งใส)
  u8g2.setFontMode(1);
  u8g2.clearBuffer();
  textBox(0, 20, 128, 24, "กำลังเริ่ม…", 1, scIdle, true);
  u8g2.sendBuffer();

  // บริการ BLE ของหน้าเว็บ: สร้างก่อน Chronos เริ่มประกาศตัว
  NimBLEDevice::init(DEVICE_NAME);
  NimBLEDevice::setMTU(247);
  NimBLEServer *srv = NimBLEDevice::createServer();
  NimBLEService *svc = srv->createService(SVC_UUID);
  NimBLECharacteristic *rx = svc->createCharacteristic(RX_UUID, NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::WRITE_NR);
  rx->setCallbacks(new RxCB());
  svc->start();

  // Chronos (Google Maps + แจ้งเตือน + สายเข้า)
  watch.setConfigurationCallback(onConfig);
  watch.setNotificationCallback(onNotification);
  watch.setRingerCallback(onRinger);
  watch.begin();
}

void loop() {
  static uint8_t view[1024];
  static bool haveFrame = false;
  char st[32];

  watch.loop();
  handleButton();

  if (fontChanged) { fontChanged = false; prefs.putUChar("fs", fontIdx); }
  if (destChanged) { destChanged = false; prefs.putString("dest", destBuf); }
  if (!ringing) callHidden = false;

  portENTER_CRITICAL(&mux);
  if (frameReady) { memcpy(view, frontBuf, 1024); frameReady = false; haveFrame = true; }
  strcpy(st, statusTxt);
  portEXIT_CRITICAL(&mux);

  bool webOn = haveFrame && (millis() - lastWebMs < 8000);
  Navigation &nav = watch.getNavigation();
  bool gmaps = watch.isConnected() && (navActive || nav.active) && !webOn;
  takeNotification(gmaps || webOn);

  // ลบชื่อจุดหมายเมื่อจบการนำทางจริง ๆ: เคยนำทางหลังตั้งชื่อแล้ว และหยุดนำทางเกิน 90 วินาที
  // (กันกรณี Maps ปิดการนำทางเก่าแล้วเริ่มใหม่ หรือคำนวณเส้นทางใหม่ระหว่างทาง)
  static uint32_t lastNavMs = 0;
  static bool navSinceDest = false;
  bool navNow = navActive || nav.active;
  if (newDest) { newDest = false; navSinceDest = false; }
  if (navNow) { lastNavMs = millis(); navSinceDest = true; }
  if (navSinceDest && !navNow && destBuf[0] && millis() - lastNavMs > 90000) {
    portENTER_CRITICAL(&mux); destBuf[0] = 0; portEXIT_CRITICAL(&mux);
    navSinceDest = false;
    destChanged = true;
  }

  // ใกล้ถึงจุดเลี้ยว (<=100 ม.) บังคับกลับหน้านำทาง และไม่ให้ป๊อปอัปบัง
  bool nearTurn = false;
  if (gmaps) { int m = navDistM(); nearTurn = m >= 0 && m <= 100; }

  u8g2.clearBuffer();
  if (ringing && !callHidden && !nearTurn) {
    screenCall();
  } else if (millis() < popupUntil && histN && !nearTurn) {
    screenNotif(hist[0], hist[0].app.length() ? hist[0].app : String("แจ้งเตือน"));
  } else if (dispMode == M_CLOCK && !nearTurn) {
    screenClock(nullptr);
  } else if (dispMode == M_NOTIF && !nearTurn) {
    if (!histN) { headerBar("แจ้งเตือน"); textBox(0, 20, 128, 44, "ยังไม่มีการแจ้งเตือน", 0, scB, true); }
    else screenNotif(hist[histView], hist[histView].app + "  " + String(histView + 1) + "/" + String(histN));
  } else if (gmaps) {
    screenNav();
  } else if (webOn) {
    memcpy(u8g2.getBufferPtr(), view, 1024);
    if (showMarker) drawMarker((millis() / 400) % 2);
    if (st[0]) {
      u8g2.setDrawColor(0); u8g2.drawBox(0, 56, 128, 8); u8g2.setDrawColor(1);
      u8g2.setFont(u8g2_font_5x7_tf); u8g2.drawStr(1, 63, st);
    }
  } else {
    screenIdle(watch.isConnected());
  }
  drawToast();
  u8g2.sendBuffer();
  delay(30);
}
