static uint8_t backBuf[1024], frontBuf[1024];
static char statusTxt[32] = "";
static volatile bool frameReady = false, showMarker = true, fontChanged = false;
static volatile uint32_t lastWebMs = 0;
static char destBuf[128] = "";
static volatile bool destChanged = false, newDest = false;
static portMUX_TYPE mux = portMUX_INITIALIZER_UNLOCKED;

class RxCB : public NimBLECharacteristicCallbacks {
  void onWrite(NimBLECharacteristic *c, NimBLEConnInfo &info) override {
    NimBLEAttValue v = c->getValue();
    const uint8_t *d = v.data();
    size_t n = v.length();
    if (n < 1) return;
    lastWebMs = millis();
    if (d[0] == 0x01 && n > 3) {
      uint16_t off = (d[1] << 8) | d[2];
      if (off >= 1024) return;
      size_t len = n - 3;
      if (off + len > 1024) len = 1024 - off;
      memcpy(backBuf + off, d + 3, len);
      if (off + len >= 1024) {
        portENTER_CRITICAL(&mux);
        memcpy(frontBuf, backBuf, 1024);
        frameReady = true;
        portEXIT_CRITICAL(&mux);
      }
    } else if (d[0] == 0x02) {
      size_t len = n - 1;
      if (len > sizeof(statusTxt) - 1) len = sizeof(statusTxt) - 1;
      portENTER_CRITICAL(&mux);
      memcpy(statusTxt, d + 1, len);
      statusTxt[len] = 0;
      portEXIT_CRITICAL(&mux);
    } else if (d[0] == 0x03 && n >= 2) {
      showMarker = d[1] & 1;
    } else if (d[0] == 0x04 && n >= 2) {
      fontIdx = d[1] > 2 ? 2 : d[1];
      fontChanged = true;
    } else if (d[0] == 0x05) {
      size_t len = n - 1;
      if (len > sizeof(destBuf) - 1) len = sizeof(destBuf) - 1;
      portENTER_CRITICAL(&mux);
      memcpy(destBuf, d + 1, len);
      destBuf[len] = 0;
      portEXIT_CRITICAL(&mux);
      destChanged = true;
      newDest = true;
      lastWebMs = 0;          // หน้าเว็บกำลังจะส่งต่อให้ Google Maps: ออกจากโหมดเว็บทันที
    }
  }
};

